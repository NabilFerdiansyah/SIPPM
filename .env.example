APP_NAME="SIPPM PG Rendeng"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/sippm/public

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==== Konfigurasi Database untuk XAMPP (MySQL/MariaDB) ====
# 1. Buka phpMyAdmin (http://localhost/phpmyadmin)
# 2. Buat database baru bernama "sippm_pgrendeng"
# 3. Sesuaikan DB_USERNAME / DB_PASSWORD jika XAMPP Anda diberi password
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sippm_pgrendeng
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_DRIVER=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_DRIVER=file

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@sippm.local"
MAIL_FROM_NAME="${APP_NAME}"
